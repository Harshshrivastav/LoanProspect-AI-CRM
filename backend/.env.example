# LLM Provider
GEMINI_API_KEY=you_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# App
APP_ENV=development
APP_SECRET_KEY=change_me_in_production
DEBUG=true

# Database
DATABASE_URL=sqlite:///./data/banking_crm.db

# Agent
MAX_AGENT_ITERATIONS=15
AGENT_VERBOSE=true
AGENT_TIMEOUT=120

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
